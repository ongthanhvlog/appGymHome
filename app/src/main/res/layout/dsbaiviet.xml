<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_gray">


    <!-- Top Bar: Back Button + Search Bar + Saved Articles -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/ibQuayLai"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_rounded_white_12dp"
            android:backgroundTint="#80FFFFFF"
            android:padding="10dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/orange_main" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="30dp"
            android:elevation="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchViewBaiViet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:iconifiedByDefault="false"
                app:queryBackground="@android:color/transparent"
                app:queryHint="Tìm tiêu đề bài viết..."
                app:searchIcon="@drawable/ic_search"
                app:theme="@style/SearchViewStyle" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llSavedArticles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bookmark_border"
                app:tint="@color/colorSaved" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bài viết đã lưu"
                android:textColor="@color/black"
                android:textSize="9sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Filter Buttons -->
    <LinearLayout
        android:id="@+id/llFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:weightSum="4"
        app:layout_constraintTop_toBottomOf="@id/llTopBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTatCaBaiViet"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:backgroundTint="@color/selector_filter_bg"
            android:text="Tất cả"
            android:textAllCaps="false"
            android:textColor="@color/selector_filter_text"
            android:textSize="11sp"
            android:padding="0dp"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_newspaper"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="14dp"
            app:iconTint="@color/selector_filter_text"
            app:strokeColor="@color/selector_filter_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBaiVietSucKhoe"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:backgroundTint="@color/selector_filter_bg"
            android:text="Sức khỏe"
            android:textAllCaps="false"
            android:textColor="@color/selector_filter_text"
            android:textSize="11sp"
            android:padding="0dp"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_health"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="14dp"
            app:iconTint="@color/selector_filter_text"
            app:strokeColor="@color/selector_filter_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBaiVietDinhDuong"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:backgroundTint="@color/selector_filter_bg"
            android:text="Dinh dưỡng"
            android:textAllCaps="false"
            android:textColor="@color/selector_filter_text"
            android:textSize="11sp"
            android:padding="0dp"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_dinhduong"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="14dp"
            app:iconTint="@color/selector_filter_text"
            app:strokeColor="@color/selector_filter_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBaiVietTapLuyen"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            app:backgroundTint="@color/selector_filter_bg"
            android:text="Tập luyện"
            android:textAllCaps="false"
            android:textColor="@color/selector_filter_text"
            android:textSize="11sp"
            android:padding="0dp"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_tapluyen"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="14dp"
            app:iconTint="@color/selector_filter_text"
            app:strokeColor="@color/selector_filter_stroke"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDanhSachBaiViet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llFilters" />

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
